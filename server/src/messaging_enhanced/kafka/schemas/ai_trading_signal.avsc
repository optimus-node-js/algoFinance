{
  "type": "record",
  "name": "AITradingSignal",
  "namespace": "hft.ai",
  "doc": "Trading signal generated by AI Intelligence Service",
  "fields": [
    {
      "name": "signal_id",
      "type": "string",
      "doc": "Unique identifier for this trading signal"
    },
    {
      "name": "timestamp",
      "type": "string",
      "doc": "ISO 8601 timestamp when signal was generated"
    },
    {
      "name": "company_symbol",
      "type": "string",
      "doc": "Stock symbol for the trading signal"
    },
    {
      "name": "company_name",
      "type": "string",
      "doc": "Company name"
    },
    {
      "name": "exchange",
      "type": "string",
      "doc": "Exchange (NSE, BSE)"
    },
    {
      "name": "signal_type",
      "type": {
        "type": "enum",
        "name": "SignalType",
        "symbols": ["BUY", "SELL", "HOLD", "STRONG_BUY", "STRONG_SELL"]
      },
      "doc": "Type of trading signal"
    },
    {
      "name": "signal_strength",
      "type": "double",
      "doc": "Signal strength (0.0 to 1.0)"
    },
    {
      "name": "confidence",
      "type": "double",
      "doc": "Confidence in the signal (0.0 to 1.0)"
    },
    {
      "name": "sentiment_score",
      "type": "double",
      "doc": "Underlying sentiment score that generated this signal"
    },
    {
      "name": "risk_score",
      "type": "double",
      "doc": "Risk assessment for this signal (0.0 to 1.0)"
    },
    {
      "name": "position_size_recommendation",
      "type": ["null", "double"],
      "default": null,
      "doc": "Recommended position size as percentage of portfolio"
    },
    {
      "name": "target_price",
      "type": ["null", "double"],
      "default": null,
      "doc": "Target price for the signal"
    },
    {
      "name": "stop_loss",
      "type": ["null", "double"],
      "default": null,
      "doc": "Stop loss price"
    },
    {
      "name": "expires_at",
      "type": ["null", "string"],
      "default": null,
      "doc": "ISO 8601 timestamp when signal expires"
    },
    {
      "name": "source_articles",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": [],
      "doc": "Array of article IDs that contributed to this signal"
    },
    {
      "name": "contributing_factors",
      "type": {
        "type": "map",
        "values": "double"
      },
      "default": {},
      "doc": "Factors that contributed to signal generation with weights"
    },
    {
      "name": "market_context",
      "type": {
        "type": "record",
        "name": "MarketContext",
        "fields": [
          {
            "name": "market_sentiment",
            "type": "double",
            "doc": "Overall market sentiment (-1.0 to 1.0)"
          },
          {
            "name": "sector_sentiment",
            "type": "double",
            "doc": "Sector-specific sentiment (-1.0 to 1.0)"
          },
          {
            "name": "volatility_index",
            "type": "double",
            "doc": "Market volatility indicator (0.0 to 1.0)"
          }
        ]
      },
      "doc": "Market context information"
    }
  ]
}
