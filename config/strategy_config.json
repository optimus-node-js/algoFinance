{
  "kafka": {
    "bootstrap.servers": "kafka:29092",
    "client.id": "hft_strategy_engine",
    "group.id": "strategy_workers",
    "auto.offset.reset": "latest",
    "enable.auto.commit": false,
    "max.poll.interval.ms": 30000
  },
  "risk_service": {
    "url": "http://risk-service:8003",
    "timeout_seconds": 5,
    "enable_risk_checks": true,
    "retry_attempts": 3
  },
  "angel_one_api": {
    "url": "http://angel-one-api:8000",
    "timeout_seconds": 10
  },
  "orchestrator": {
    "orchestrator_id": "hft_main_orchestrator",
    "max_workers": 3,
    "health_check_interval": 30,
    "load_balance_interval": 60,
    "enable_auto_scaling": true,
    "min_workers": 1,
    "max_worker_load": 0.8,
    "metrics_update_interval": 10
  },
  "workers": [
    {
      "worker_id": "momentum_worker",
      "input_topics": ["market_data", "market_tick"],
      "output_topic": "trading_signals",
      "max_strategies": 3
    },
    {
      "worker_id": "arbitrage_worker", 
      "input_topics": ["market_data", "market_sentiment"],
      "output_topic": "arbitrage_signals",
      "max_strategies": 2
    }
  ],
  "strategies": [
    {
      "strategy_id": "momentum_nifty50",
      "strategy_class": "MomentumStrategy",
      "symbol": "NIFTY50",
      "timeframe": "1m",
      "worker_id": "momentum_worker",
      "parameters": {
        "momentum_threshold": 0.015,
        "rsi_momentum_level": 65,
        "sma_fast_period": 10,
        "sma_slow_period": 20,
        "volume_threshold": 1.8,
        "min_confidence": 0.7
      }
    },
    {
      "strategy_id": "momentum_banknifty",
      "strategy_class": "MomentumStrategy", 
      "symbol": "BANKNIFTY",
      "timeframe": "1m",
      "worker_id": "momentum_worker",
      "parameters": {
        "momentum_threshold": 0.02,
        "rsi_momentum_level": 60,
        "sma_fast_period": 8,
        "sma_slow_period": 21,
        "volume_threshold": 2.0,
        "min_confidence": 0.75
      }
    },
    {
      "strategy_id": "momentum_reliance",
      "strategy_class": "MomentumStrategy",
      "symbol": "RELIANCE",
      "timeframe": "5m",
      "worker_id": "momentum_worker",
      "parameters": {
        "momentum_threshold": 0.025,
        "rsi_momentum_level": 58,
        "sma_fast_period": 12,
        "sma_slow_period": 26,
        "volume_threshold": 1.5,
        "min_confidence": 0.65
      }
    }
  ],
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file_path": "/app/logs/strategy_engine.log",
    "max_file_size": "10MB",
    "backup_count": 5
  },
  "metrics": {
    "enable_metrics_server": true,
    "metrics_port": 8004,
    "update_interval": 10,
    "export_prometheus": true
  },
  "performance": {
    "max_signal_latency_ms": 100,
    "max_processing_time_ms": 50,
    "target_throughput_msg_per_sec": 1000,
    "memory_limit_mb": 512
  }
}

